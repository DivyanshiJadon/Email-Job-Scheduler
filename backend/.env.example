# ===== Server =====
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ===== Redis (BullMQ) =====
REDIS_URL=redis://localhost:6379

# ===== MySQL (optional: swap ports if you use a local MySQL instead of Docker) =====
DB_HOST=localhost
DB_PORT=3307
DB_USER=reachinbox
DB_PASSWORD=reachinbox
DB_NAME=reachinbox

# ===== Elasticsearch =====
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox_emails

# ===== Ethereal SMTP =====
# Leave ETHEREAL_* empty to auto-provision + cache accounts on disk
# (.ethereal-accounts.json). Or pin one shared mailbox:
# ETHEREAL_HOST=smtp.ethereal.email
# ETHEREAL_PORT=587
# ETHEREAL_USER=xxxx.yyyy@ethereal.email
# ETHEREAL_PASS=xxxxxxxxxxx
# EMAIL_FROM=ReachInbox <xxxx.yyyy@ethereal.email>

# ===== Scheduler =====
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=60
JOB_ATTEMPTS=6

# ===== Auth =====
JWT_SECRET=change-me-to-a-long-random-string
AUTH_DEMO_MODE=true

# Real Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ===== Slack =====
# Slack app with OAuth scopes: chat:write, channels:read, groups:read
# SLACK_CLIENT_ID=000000000000.0000000000000
# SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
# SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback
# SLACK_CHANNEL=#reachinbox-alerts